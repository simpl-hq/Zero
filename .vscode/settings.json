{
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "haskell.formattingProvider": "fourmolu",
  "haskell.manageHLS": "GHCup",
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "./apps/zero-pin-broker",
    "-p",
    "test_*.py"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "dist-newstyle": true
  },
  "search.exclude": {
    "dist-newstyle/**": true,
    "apps/multiplatform/**/build/**": true,
    "vendor/**": false
  },
  "[haskell]": {
    "editor.tabSize": 2
  },
  "[kotlin]": {
    "editor.tabSize": 2
  },
  "[swift]": {
    "editor.tabSize": 4
  },
  "[python]": {
    "editor.tabSize": 4
  }
}
