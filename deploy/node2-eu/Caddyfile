# Caddy TLS reverse proxy (EU Edge) with access logs disabled.
{
	log {
		output discard
	}
}

zeroapi.simpl.global, zeroeu.simpl.global {
	log {
		output discard
	}
	reverse_proxy 127.0.0.1:8000 {
		header_up -X-Forwarded-For
		header_up X-Real-IP {remote_host}
	}
	respond /turn 200
}

zerostatus.simpl.global {
	log {
		output discard
	}
	reverse_proxy 127.0.0.1:3001 {
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}
